{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopr",
  "version": "0.1.0",
  "identifier": "app.hopr.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hopr",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "decorations": false,
        "transparent": true,
        "center": true,
        "backgroundColor": "#0F0E0D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fast, lightweight SSH client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RTI4MzEyRjgyN0NGQTkKUldTcHp5ZjRFb1BpQlBjck1KTXY4Wjk5cllZdSt1VzZPZnd6U1lkUFpoc2xqT1luK3o0cmhmYnoK",
      "endpoints": [
        "https://github.com/JapnoorHere/hopr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
