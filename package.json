{
  "name": "hopr",
  "version": "0.1.0",
  "private": true,
  "description": "Hopr: a fast, lightweight SSH client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check --css-parse-tailwind-directives=true . && node scripts/check-tokens.mjs",
    "format": "biome check --write --css-parse-tailwind-directives=true .",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/commit-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "phosphor-svelte": "3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
